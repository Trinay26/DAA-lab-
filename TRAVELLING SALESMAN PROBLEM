#include <stdio.h>
#include <limits.h>

#define MAX 10

int n, cost[MAX][MAX];
int visited[MAX];

// Function to find minimum cost
int tsp(int city, int count) {
    int i, min = INT_MAX, temp;

    // If all cities are visited, return cost to go back to start
    if (count == n && cost[city][0]) {
        return cost[city][0];
    }

    for (i = 0; i < n; i++) {
        if (!visited[i] && cost[city][i]) {
            visited[i] = 1;

            temp = cost[city][i] + tsp(i, count + 1);

            if (temp < min)
                min = temp;

            visited[i] = 0; // backtrack
        }
    }

    return min;
}

int main() {
    int i, j;

    printf("Enter number of cities: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    for (i = 0; i < n; i++)
        visited[i] = 0;

    visited[0] = 1; // start from city 0

    int result = tsp(0, 1);

    printf("Minimum travelling cost = %d\n", result);

    return 0;
}
